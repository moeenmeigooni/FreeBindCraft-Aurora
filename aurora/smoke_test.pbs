#!/bin/bash -l
# Supply your account and queue at submission time, for example:
# qsub -A FRAME-IDP -q debug aurora/smoke_test.pbs
# This intentionally occupies one tile only: establish numerical and functional
# correctness before launching an embarrassingly-parallel trajectory ensemble.
#PBS -N freebindcraft-smoke
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=0:20:00
#PBS -l filesystems=home:flare

set -eo pipefail
cd "${PBS_O_WORKDIR}"

module load "${AURORA_JAX_ONEAPI_MODULE:-oneapi/release/2025.3.1}"
set -u
freebindcraft_env="${FREEBINDCRAFT_AURORA_ENV:-${PBS_O_WORKDIR}/.venv-aurora}"
if [[ ! -x "${freebindcraft_env}/bin/python" ]]; then
  echo "FreeBindCraft environment is missing its Python executable: ${freebindcraft_env}/bin/python" >&2
  exit 2
fi
source "${PBS_O_WORKDIR}/aurora/runtime_env.sh" "${freebindcraft_env}"
# A prefix created with `conda env create --prefix` need not contain a
# `bin/activate` helper.  Calling its interpreter through PATH is both enough
# and avoids sourcing a shell implementation that differs between Aurora
# framework-module releases.
export PATH="${freebindcraft_env}/bin:${PATH}"

# One process must see one GPU tile.  Do not let a single JAX process reserve
# all visible tiles during the first validation run.
export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ZE_AFFINITY_MASK=0.0
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export OPENMM_PLATFORM_ORDER=OpenCL,CPU
export OPENMM_DEFAULT_PLATFORM=OpenCL
export OPENMM_CPU_THREADS=1
export FASPR_BIN="${PBS_O_WORKDIR}/aurora/bin/FASPR"

python aurora/validate_aurora.py
python extras/test_openmm_relax.py example/PDL1.pdb "$PBS_O_WORKDIR/aurora_smoke/PDL1_relaxed" \
  --platform opencl --md-steps-per-shake 0 --faspr
