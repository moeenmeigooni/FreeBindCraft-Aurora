#!/bin/bash -l
# One independent FreeBindCraft process on one Aurora GPU tile.  Supply account
# and queue at qsub time, and set SETTINGS, FILTERS, and ADVANCED below.
#PBS -N freebindcraft
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=2:00:00
#PBS -l filesystems=home:flare

set -eo pipefail
cd "${PBS_O_WORKDIR}"

module load "${AURORA_JAX_ONEAPI_MODULE:-oneapi/release/2025.3.1}"
set -u
freebindcraft_env="${FREEBINDCRAFT_AURORA_ENV:-${PBS_O_WORKDIR}/.venv-aurora}"
if [[ ! -x "${freebindcraft_env}/bin/python" ]]; then
  echo "FreeBindCraft environment is missing its Python executable: ${freebindcraft_env}/bin/python" >&2
  exit 2
fi
source "${PBS_O_WORKDIR}/aurora/runtime_env.sh" "${freebindcraft_env}"
export PATH="${freebindcraft_env}/bin:${PATH}"

export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ZE_AFFINITY_MASK=0.0
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export OPENMM_PLATFORM_ORDER=OpenCL,CPU
export OPENMM_DEFAULT_PLATFORM=OpenCL
export OPENMM_CPU_THREADS=1
export FASPR_BIN="${PBS_O_WORKDIR}/aurora/bin/FASPR"

SETTINGS="settings_target/PDL1.json"
FILTERS="settings_filters/default_filters.json"
ADVANCED="settings_advanced/default_4stage_multimer.json"

python -u bindcraft.py \
  --settings "${SETTINGS}" \
  --filters "${FILTERS}" \
  --advanced "${ADVANCED}" \
  --no-pyrosetta \
  --no-animations \
  --verbose
