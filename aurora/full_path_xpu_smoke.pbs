#!/bin/bash -l
# Full post-trajectory integration validation.  This is intentionally isolated
# from scientific design outputs and only validates the no-PyRosetta workflow.
#PBS -N freebindcraft-full-path-smoke
#PBS -l select=1
#PBS -l place=scatter
#PBS -l walltime=1:00:00
#PBS -l filesystems=home:flare

set -eo pipefail
cd "${PBS_O_WORKDIR}"

module load frameworks
set -u
freebindcraft_env="${FREEBINDCRAFT_AURORA_ENV:-${PBS_O_WORKDIR}/.venv-aurora}"
if [[ ! -x "${freebindcraft_env}/bin/python" ]]; then
  echo "FreeBindCraft environment is missing its Python executable: ${freebindcraft_env}/bin/python" >&2
  exit 2
fi
source "${PBS_O_WORKDIR}/aurora/runtime_env.sh" "${freebindcraft_env}"
export PATH="${freebindcraft_env}/bin:${PATH}"
echo "FreeBindCraft runtime home: ${HOME}"
echo "FreeBindCraft cache root: ${FREEBINDCRAFT_CACHE_ROOT}"
if [[ ! -f "${PBS_O_WORKDIR}/params/params_model_5_ptm.npz" ]]; then
  echo "AlphaFold parameters are not staged. Run aurora/bootstrap_aurora.sh without --no-weights." >&2
  exit 2
fi

export ZE_FLAT_DEVICE_HIERARCHY=COMPOSITE
export ZE_AFFINITY_MASK=0.0
export ONEAPI_DEVICE_SELECTOR=level_zero:gpu
export OPENMM_PLATFORM_ORDER=OpenCL,CPU
export OPENMM_DEFAULT_PLATFORM=OpenCL
export OPENMM_CPU_THREADS=1
export FASPR_BIN="${PBS_O_WORKDIR}/aurora/bin/FASPR"

python -u aurora/full_path_xpu_smoke.py \
  --output "${FREEBINDCRAFT_FULL_PATH_OUTPUT:-aurora_full_path_xpu_smoke}" \
  --validation-mode "${FREEBINDCRAFT_FULL_PATH_MODE:-standard}"
